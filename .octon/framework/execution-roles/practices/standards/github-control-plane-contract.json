{
  "version": "2026-07-17",
  "default_work_unit_policy_ref": ".octon/framework/product/contracts/default-work-unit.yml",
  "change_receipt_schema_ref": ".octon/framework/product/contracts/change-receipt-v1.schema.json",
  "scope": {
    "projection_host_for": "route-aware Change lifecycle GitHub projection",
    "not_authority_for": [
      "default work unit",
      "Change route selection",
      "lifecycle outcome authority",
      "direct-main eligibility",
      "branch-only completion",
      "live GitHub ruleset mutation"
    ]
  },
  "change_routes": {
    "hosted_pr_route": "branch-pr",
    "no_pr_routes": [
      "direct-main",
      "branch-no-pr",
      "stage-only-escalate"
    ],
    "landing_routes": [
      "direct-main",
      "branch-no-pr",
      "branch-pr"
    ]
  },
  "default_branch": "main",
  "rulesets": {
    "current_live_main": {
      "expectation": "target-route-neutral",
      "migration_status": "post-route-neutral-live-cutover",
      "applies_to_routes": [
        "direct-main",
        "branch-no-pr",
        "branch-pr"
      ],
      "required_checks": [
        "route_neutral_closeout_validation",
        "branch_naming_validation",
        "route_aware_autonomy_validation",
        "exact_source_sha_validation"
      ],
      "require_review_thread_resolution": false,
      "migration_evidence_ref": ".octon/state/evidence/control/execution/github-rulesets/2026-05-04-route-neutral-main-migration/",
      "note": "Documents the live post-migration posture proven by accepted ruleset migration and strict-live validation. PR review-thread requirements remain branch-pr route behavior, not universal main rules."
    },
    "target_route_neutral_main": {
      "expectation": "target-route-neutral",
      "migration_status": "accepted-live-posture",
      "applies_to_routes": [
        "direct-main",
        "branch-no-pr",
        "branch-pr"
      ],
      "required_main_rules": [
        "required_status_checks",
        "required_linear_history",
        "non_fast_forward",
        "deletion_protection"
      ],
      "forbidden_universal_rules": [
        "pull_request_required_for_all_main_updates"
      ],
      "universal_required_checks": [
        "route_neutral_closeout_validation",
        "branch_naming_validation",
        "route_aware_autonomy_validation",
        "exact_source_sha_validation"
      ],
      "pr_specific_checks": [
        "AI Review Gate / decision",
        "PR Quality Standards",
        "Validate autonomy policy",
        "PR Auto Merge",
        "PR Clean State Enforcer",
        "Codex PR Review"
      ],
      "hosted_no_pr_evidence_required": [
        "provider_ruleset_ref",
        "pushed_source_branch",
        "remote_branch_ref",
        "source_ref_equals_validated_ref",
        "required_check_refs_bind_exact_source_ref",
        "integration_method_fast_forward",
        "rollback_handle",
        "cleanup_status",
        "target_post_ref_equals_landed_ref_equals_github_sha",
        "origin_main_equals_landed_ref_after_push"
      ],
      "live_mutation_performed_by_this_projection": false
    }
  },
  "repository_settings": {
    "allow_auto_merge": true,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "delete_branch_on_merge": true
  },
  "branch_pr_autonomous_completion": {
    "route": "branch-pr",
    "allowed_for_open_draft_prs": true,
    "requires_autonomous_lane": true,
    "high_impact_posture": {
      "classification": "risk:high",
      "autonomy_model": "elevated-autonomy",
      "manual_default": false,
      "requires_explicit_self_review": true,
      "requires_post_merge_origin_main_verification": true,
      "escalate_only_for_concrete_blockers": true
    },
    "required_checks": [
      "AI Review Gate / decision when required",
      "PR Quality Standards",
      "Validate branch naming",
      "PR Clean State Enforcer",
      "Validate autonomy policy"
    ],
    "requires_no_unresolved_author_action_threads": true,
    "requires_no_blocking_labels": true,
    "requires_no_requested_changes": true,
    "requires_no_merge_conflicts": true,
    "requires_no_stale_head_state": true,
    "requires_change_receipt_or_closeout_evidence": true,
    "merge_path": "current live protected-main ruleset",
    "protected_main_bypass_allowed": false,
    "live_ruleset_mutation_allowed": false
  },
  "actions_permissions": {
    "workflow": {
      "can_approve_pull_request_reviews": true
    }
  },
  "direct_main_projection": {
    "github_pr_metadata_required": false,
    "required_local_evidence": [
      "change_receipt",
      "local_validation",
      "rollback_handle",
      "landed_commit"
    ]
  },
  "hosted_branch_no_pr_projection": {
    "github_pr_metadata_required": false,
    "required_hosted_evidence": [
      "route-neutral provider ruleset compatibility",
      "pushed source branch",
      "exact source SHA required checks",
      "fast-forward-only protected update",
      "rollback handle",
      "cleanup disposition",
      "origin/main equals landed ref"
    ]
  },
  "rp00_owner_lane_cutover": {
    "operation_id": "rp00-owner-lane-cutover",
    "repository": "jamesryancooper/octon",
    "runtime_action": "rp00_owner_lane_cutover",
    "runtime_contract_ref": ".octon/framework/engine/runtime/spec/owner-lane-execution-v1.md",
    "consumer_api_ref": ".octon/framework/engine/runtime/crates/kernel/src/owner_lane.rs::execute_with_verified_effect",
    "authorized_effect_token_type": "AuthorizedEffect<ProviderRepositoryMutation>",
    "credential_class": "fine-grained-personal-access-token",
    "credential_capture": "inherited-fd-once",
    "http_secret_transport": "curl-config-via-stdin",
    "git_secret_transport": "one-use-fifo-via-fixed-askpass",
    "prohibited_clients": ["gh", "ssh", "ambient credential helper", "general API client"],
    "unknown_outcome_resend_allowed": false,
    "revocation_endpoint": "https://api.github.com/credentials/revoke",
    "revocation_authenticated": false,
    "revocation_acceptance_status": 202,
    "terminal_identity_status": 401,
    "retained_hermetic_proof_ref": ".octon/state/evidence/validation/owner-lane-runtime/2026-07-17-hermetic-proof.yml",
    "live_execution_requires_fresh_exact_authorization": true
  }
}
