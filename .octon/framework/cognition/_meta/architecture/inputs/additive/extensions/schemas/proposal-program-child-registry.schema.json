{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/schemas/proposal-program-child-registry.schema.json",
  "title": "Octon Proposal Program Child Registry",
  "description": "Authored parent-program child registry for proposal-program lifecycle orchestration. The v2 schema is required for executable program-atomic runs.",
  "type": "object",
  "required": [
    "schema_version",
    "execution_mode",
    "children"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "octon-proposal-program-child-registry-v1",
        "octon-proposal-program-child-registry-v2"
      ]
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "sequential",
        "parallel-independent",
        "gated-parallel",
        "approval-gated",
        "program-atomic"
      ]
    },
    "default_child_lifecycle_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "write_scope_collision_ledger": {
      "$ref": "#/$defs/write_scope_collision_ledger"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/child"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "octon-proposal-program-child-registry-v1"
          }
        }
      },
      "then": {
        "properties": {
          "execution_mode": {
            "enum": [
              "sequential",
              "parallel-independent",
              "gated-parallel",
              "approval-gated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "program-atomic"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "octon-proposal-program-child-registry-v2"
          },
          "children": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/child"
                },
                {
                  "$ref": "#/$defs/atomic_child"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          {
            "pattern": "(^|/)\\.(/|$)"
          }
        ]
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "child": {
      "type": "object",
      "required": [
        "child_id",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "child_id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "required": {
          "type": "boolean"
        },
        "deferred": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "dependency_gate": {
          "type": "string",
          "enum": [
            "terminal",
            "verification",
            "closeout"
          ]
        },
        "phase_id": {
          "$ref": "#/$defs/identifier"
        },
        "group_id": {
          "$ref": "#/$defs/identifier"
        },
        "rollback_posture": {
          "type": "string",
          "enum": [
            "none",
            "manual",
            "forward-only",
            "superseded",
            "replaced",
            "rejected",
            "compensating",
            "staged-commit",
            "rollback-route"
          ]
        },
        "supersession_evidence": {
          "$ref": "#/$defs/relative_path"
        },
        "replacement_child_id": {
          "$ref": "#/$defs/identifier"
        },
        "replacement_for": {
          "$ref": "#/$defs/identifier"
        },
        "recovery_profile": {
          "$ref": "#/$defs/identifier"
        },
        "phase_commit_barrier": {
          "$ref": "#/$defs/identifier"
        },
        "write_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "uniqueItems": true
        },
        "seed_role": {
          "type": "string",
          "enum": [
            "seed",
            "reference",
            "seed-reference",
            "first-child",
            "follow-on"
          ]
        },
        "child_lifecycle_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "required_metadata": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "change_profile"
            ]
          },
          "uniqueItems": true
        },
        "source_lineage_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "uniqueItems": true
        },
        "parent_contract_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "uniqueItems": true
        },
        "readiness_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readiness_requirement"
          },
          "uniqueItems": true
        },
        "predecessor_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predecessor_constraint"
          },
          "uniqueItems": true
        },
        "successor_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/successor_constraint"
          },
          "uniqueItems": true
        },
        "cutover_constraints": {
          "$ref": "#/$defs/cutover_constraints"
        }
      }
    },
    "readiness_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "summary"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/identifier"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "review_must_mention": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "predecessor_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_child_id",
        "constraint"
      ],
      "properties": {
        "predecessor_child_id": {
          "$ref": "#/$defs/identifier"
        },
        "constraint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "successor_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successor_child_id",
        "constraint"
      ],
      "properties": {
        "successor_child_id": {
          "$ref": "#/$defs/identifier"
        },
        "constraint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cutover_constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compatibility_retirement_requires_predecessor_evidence": {
          "type": "boolean"
        },
        "canonical_runtime_support_requires_predecessor_evidence": {
          "type": "boolean"
        },
        "required_predecessor_child_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "forbidden_claims_until_ready": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "compatibility-retired",
              "canonical-runtime-support"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "atomic_child": {
      "required": [
        "dependency_gate",
        "recovery_profile",
        "rollback_posture",
        "write_scopes"
      ],
      "properties": {
        "write_scopes": {
          "minItems": 1
        }
      }
    },
    "write_scope_collision_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "registry_write_scopes_digest",
        "derived_counts",
        "records"
      ],
      "properties": {
        "schema_version": {
          "const": "octon-program-write-scope-collision-ledger-v1"
        },
        "enforcement_state": {
          "type": "string",
          "minLength": 1
        },
        "mutation_guard": {
          "type": "string",
          "minLength": 1
        },
        "registry_projection_format": {
          "type": "string",
          "minLength": 1
        },
        "registry_write_scopes_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "derived_counts": {
          "$ref": "#/$defs/write_scope_collision_counts"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/write_scope_collision_record"
          }
        }
      }
    },
    "write_scope_collision_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_count",
        "scope_entries",
        "unique_paths",
        "exact_records",
        "directory_prefix_records",
        "total_records"
      ],
      "properties": {
        "child_count": {
          "type": "integer",
          "minimum": 1
        },
        "scope_entries": {
          "type": "integer",
          "minimum": 0
        },
        "unique_paths": {
          "type": "integer",
          "minimum": 0
        },
        "exact_records": {
          "type": "integer",
          "minimum": 0
        },
        "directory_prefix_records": {
          "type": "integer",
          "minimum": 0
        },
        "total_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "write_scope_collision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collision_id",
        "participants",
        "collision_kind",
        "integration_owner_child_id",
        "serialization"
      ],
      "properties": {
        "collision_id": {
          "type": "string",
          "pattern": "^WSC-[0-9]{3,}$"
        },
        "participants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/write_scope_collision_participant"
          }
        },
        "collision_kind": {
          "type": "string",
          "enum": [
            "exact",
            "directory-prefix"
          ]
        },
        "integration_owner_child_id": {
          "$ref": "#/$defs/identifier"
        },
        "serialization": {
          "$ref": "#/$defs/write_scope_collision_serialization"
        }
      }
    },
    "write_scope_collision_participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_id",
        "write_scope",
        "contribution"
      ],
      "properties": {
        "child_id": {
          "$ref": "#/$defs/identifier"
        },
        "write_scope": {
          "$ref": "#/$defs/relative_path"
        },
        "contribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "write_scope_collision_serialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "ordered_child_ids"
      ],
      "properties": {
        "mechanism": {
          "type": "string",
          "enum": [
            "dependency-order",
            "exclusive-integration-lock"
          ]
        },
        "lock_id": {
          "$ref": "#/$defs/identifier"
        },
        "ordered_child_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
