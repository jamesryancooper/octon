{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/framework/constitution/contracts/retention/publishable-evidence-receipt-v1.schema.json",
  "title": "Octon Publishable Evidence Receipt v1",
  "description": "Claim-bearing repo-publishable receipt that proves a bounded claim without publishing private raw evidence or local operational detail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_mode",
    "created_at",
    "issuer_ref",
    "disclosure_tier",
    "evidence_tier_ref",
    "claim_scope",
    "source_summary",
    "validation_summary",
    "redactions",
    "limitations",
    "local_evidence_refs",
    "outcome",
    "rollback_or_discard",
    "authority_boundaries",
    "concision"
  ],
  "properties": {
    "schema_version": {
      "const": "publishable-evidence-receipt-v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "receipt_mode": {
      "type": "string",
      "enum": ["claim", "example_fixture"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer_ref": {
      "type": "string",
      "minLength": 1
    },
    "disclosure_tier": {
      "const": "repo-publishable"
    },
    "evidence_tier_ref": {
      "const": "repo_publishable_evidence"
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "statement", "applies_to"],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "validation",
            "closeout",
            "repo-hygiene",
            "disclosure",
            "support-proof",
            "implementation-promotion",
            "example"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "source_refs", "raw_evidence_published"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_evidence_published": {
          "const": false
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "commands_or_checks", "evidence_refs"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail", "blocked", "deferred", "example-only"]
        },
        "commands_or_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "redactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "redacted_fields"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not-required", "applied", "not-applicable"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "redacted_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limitation_id", "description", "impact"],
        "properties": {
          "limitation_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "local_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_kind",
          "ref",
          "digest_algorithm",
          "digest",
          "raw_evidence_not_published"
        ],
        "properties": {
          "ref_kind": {
            "type": "string",
            "enum": ["repo-relative-path", "logical-id", "external-index"]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "digest_algorithm": {
            "const": "sha256"
          },
          "digest": {
            "$ref": "#/$defs/sha256Digest"
          },
          "raw_evidence_not_published": {
            "const": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "summary", "decided_at"],
      "properties": {
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "blocked", "deferred", "example-only"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "rollback_or_discard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "trigger", "instructions"],
      "properties": {
        "posture": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_inputs_not_authority",
        "generated_outputs_not_authority",
        "proposal_paths_not_authority",
        "host_state_not_authority",
        "parent_program_evidence_not_substitute"
      ],
      "properties": {
        "raw_inputs_not_authority": {
          "const": true
        },
        "generated_outputs_not_authority": {
          "const": true
        },
        "proposal_paths_not_authority": {
          "const": true
        },
        "host_state_not_authority": {
          "const": true
        },
        "parent_program_evidence_not_substitute": {
          "const": true
        }
      }
    },
    "concision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_receipt_size_bytes",
        "warning_threshold_bytes",
        "failure_threshold_bytes",
        "size_exception_authorized"
      ],
      "properties": {
        "declared_receipt_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "warning_threshold_bytes": {
          "const": 65536
        },
        "failure_threshold_bytes": {
          "const": 262144
        },
        "size_exception_authorized": {
          "type": "boolean"
        },
        "size_exception_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "size_exception_authorized": {
                "const": false
              }
            },
            "required": ["size_exception_authorized"]
          },
          "then": {
            "properties": {
              "declared_receipt_size_bytes": {
                "maximum": 262144
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "size_exception_authorized": {
                "const": true
              }
            },
            "required": ["size_exception_authorized"]
          },
          "then": {
            "required": ["size_exception_ref"]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt_mode": {
            "const": "claim"
          }
        },
        "required": ["receipt_mode"]
      },
      "then": {
        "properties": {
          "claim_scope": {
            "properties": {
              "claim_type": {
                "not": {
                  "const": "example"
                }
              }
            }
          },
          "outcome": {
            "properties": {
              "result": {
                "not": {
                  "const": "example-only"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "receipt_mode": {
            "const": "example_fixture"
          }
        },
        "required": ["receipt_mode"]
      },
      "then": {
        "properties": {
          "claim_scope": {
            "properties": {
              "claim_type": {
                "const": "example"
              }
            }
          },
          "outcome": {
            "properties": {
              "result": {
                "const": "example-only"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
