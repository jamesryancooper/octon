{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/framework/constitution/contracts/disclosure/run-card-v2.schema.json",
  "title": "Octon RunCard v2",
  "description": "Runtime-backed disclosure artifact for one consequential run in the globally complete support universe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "claim_status",
    "status",
    "summary",
    "workflow_mode",
    "support_tier",
    "support_target_tuple",
    "support_target_ref",
    "requested_capability_packs",
    "adapter_support",
    "authority_refs",
    "runtime_service_refs",
    "proof_plane_refs",
    "measurement_ref",
    "intervention_ref",
    "replay_ref",
    "recovery_ref",
    "known_limits",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "run-card-v2" },
    "run_id": { "type": "string", "minLength": 1 },
    "claim_status": {
      "type": "string",
      "enum": ["supported", "stage_only", "unsupported"]
    },
    "status": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "workflow_mode": { "type": "string", "minLength": 1 },
    "support_tier": { "type": "string", "minLength": 1 },
    "support_target_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_tier",
        "workload_tier",
        "language_resource_tier",
        "locale_tier",
        "support_status"
      ],
      "properties": {
        "model_tier": { "type": "string", "minLength": 1 },
        "workload_tier": { "type": "string", "minLength": 1 },
        "language_resource_tier": { "type": "string", "minLength": 1 },
        "locale_tier": { "type": "string", "minLength": 1 },
        "support_status": { "type": "string", "enum": ["supported", "stage_only", "unsupported"] }
      }
    },
    "support_target_ref": { "type": "string", "minLength": 1 },
    "requested_capability_packs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "adapter_support": { "type": "object" },
    "authority_refs": { "type": "object" },
    "runtime_service_refs": { "type": "object" },
    "proof_plane_refs": { "type": "object" },
    "measurement_ref": { "type": "string", "minLength": 1 },
    "intervention_ref": { "type": "string", "minLength": 1 },
    "replay_ref": { "type": "string", "minLength": 1 },
    "recovery_ref": { "type": "string", "minLength": 1 },
    "publishable_evidence_receipt_refs": {
      "type": "array",
      "description": "Repo-publishable receipts that summarize or attest local/private evidence supporting a hosted, shared, closeout, or release-facing run claim without publishing raw evidence.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_ref",
          "schema_ref",
          "disclosure_tier",
          "raw_evidence_not_published"
        ],
        "properties": {
          "receipt_ref": { "type": "string", "minLength": 1 },
          "schema_ref": {
            "const": ".octon/framework/constitution/contracts/retention/publishable-evidence-receipt-v1.schema.json"
          },
          "disclosure_tier": { "const": "repo-publishable" },
          "claim_scope_ref": { "type": "string", "minLength": 1 },
          "receipt_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "raw_evidence_not_published": { "const": true }
        }
      }
    },
    "local_evidence_limitations": {
      "type": "array",
      "description": "Operator-facing limitations for local-only evidence that is cited by digest or receipt but not published as raw payload.",
      "items": { "type": "string" }
    },
    "known_limits": {
      "type": "array",
      "items": { "type": "string" }
    },
    "generated_at": { "type": "string", "minLength": 1 }
  }
}
