{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-credential-retirement-receipt-v1",
  "title": "Owner-lane credential retirement receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "authorization_digest", "operation_plan_digest", "lifecycle_digest", "revocation_status", "terminal_identity_status", "prior_authenticated_200", "local_buffer_zeroized", "fifo_removed", "secret_census_empty", "retired", "completed_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-credential-retirement-receipt-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "authorization_digest": {"$ref": "#/$defs/digest"},
    "operation_plan_digest": {"$ref": "#/$defs/digest"},
    "lifecycle_digest": {"$ref": "#/$defs/digest"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "attestation_digest": {"$ref": "#/$defs/digest"},
    "completed_prefix_digest": {"$ref": "#/$defs/digest"},
    "revocation_status": {"const": 202},
    "terminal_identity_status": {"const": 401},
    "prior_authenticated_200": {"const": true},
    "local_buffer_zeroized": {"const": true},
    "fifo_removed": {"const": true},
    "secret_census_empty": {"const": true},
    "retired": {"const": true},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
