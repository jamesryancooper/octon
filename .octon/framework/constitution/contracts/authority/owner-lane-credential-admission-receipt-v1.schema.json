{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-credential-admission-receipt-v1",
  "title": "Owner-lane credential admission receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "lifecycle_digest", "operation_plan_digest", "identity_status", "repository_status", "login", "id", "api_version", "accepted_permissions", "identity_request_digest", "identity_response_digest", "repository_request_digest", "repository_response_digest", "trusted_capture_facts_digest", "pagination_complete", "admitted", "prior_authenticated_200", "recorded_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-credential-admission-receipt-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "lifecycle_digest": {"$ref": "#/$defs/digest"},
    "operation_plan_digest": {"$ref": "#/$defs/digest"},
    "identity_status": {"const": 200},
    "repository_status": {"const": 200},
    "login": {"const": "jamesryancooper"},
    "id": {"const": 800837},
    "api_version": {"const": "2026-03-10"},
    "accepted_permissions": {"type": "object", "additionalProperties": false, "required": ["administration", "actions", "variables", "contents", "pull_requests", "checks", "commit_statuses", "metadata"], "properties": {"administration": {"const": "write"}, "actions": {"const": "write"}, "variables": {"const": "write"}, "contents": {"const": "write"}, "pull_requests": {"const": "write"}, "checks": {"const": "read"}, "commit_statuses": {"const": "read"}, "metadata": {"const": "read"}}},
    "identity_request_digest": {"$ref": "#/$defs/digest"},
    "identity_response_digest": {"$ref": "#/$defs/digest"},
    "repository_request_digest": {"$ref": "#/$defs/digest"},
    "repository_response_digest": {"$ref": "#/$defs/digest"},
    "trusted_capture_facts_digest": {"$ref": "#/$defs/digest"},
    "pagination_complete": {"const": true},
    "admitted": {"const": true},
    "prior_authenticated_200": {"const": true},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
