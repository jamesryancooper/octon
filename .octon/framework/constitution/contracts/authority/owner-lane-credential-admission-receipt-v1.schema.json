{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-credential-admission-receipt-v1",
  "title": "Owner-lane credential admission receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "lifecycle_digest", "identity_status", "repository_status", "login", "id", "api_version", "accepted_permissions", "pagination_complete", "admitted", "prior_authenticated_200", "recorded_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-credential-admission-receipt-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "lifecycle_digest": {"$ref": "#/$defs/digest"},
    "identity_status": {"const": 200},
    "repository_status": {"const": 200},
    "login": {"type": "string", "minLength": 1},
    "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "api_version": {"const": "2026-03-10"},
    "accepted_permissions": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["read", "write"]}},
    "pagination_complete": {"const": true},
    "admitted": {"const": true},
    "prior_authenticated_200": {"const": true},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
