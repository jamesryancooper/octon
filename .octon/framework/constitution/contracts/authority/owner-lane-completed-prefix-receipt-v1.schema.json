{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-completed-prefix-receipt-v1",
  "title": "Owner-lane completed prefix receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "manifest_digest", "attestation_digest", "operation_plan_digest", "completed_operation_ids", "last_sequence", "journal_digest", "pull_request_create_request_digest", "pull_request_create_response_digest", "pull_request_reconcile_request_digest", "pull_request_reconcile_response_digest", "canonical_pr_number", "repository", "base_sha", "head_sha", "candidate_tree", "branch", "terminal_state", "recorded_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-completed-prefix-receipt-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "attestation_digest": {"$ref": "#/$defs/digest"},
    "operation_plan_digest": {"$ref": "#/$defs/digest"},
    "completed_operation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "last_sequence": {"const": 7},
    "journal_digest": {"$ref": "#/$defs/digest"},
    "pull_request_create_request_digest": {"$ref": "#/$defs/digest"},
    "pull_request_create_response_digest": {"$ref": "#/$defs/digest"},
    "pull_request_reconcile_request_digest": {"$ref": "#/$defs/digest"},
    "pull_request_reconcile_response_digest": {"$ref": "#/$defs/digest"},
    "canonical_pr_number": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "repository": {"const": "jamesryancooper/octon"},
    "base_sha": {"$ref": "#/$defs/gitSha"},
    "head_sha": {"$ref": "#/$defs/gitSha"},
    "candidate_tree": {"$ref": "#/$defs/gitSha"},
    "branch": {"type": "string", "minLength": 1},
    "terminal_state": {"const": "prefix-complete"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
}
