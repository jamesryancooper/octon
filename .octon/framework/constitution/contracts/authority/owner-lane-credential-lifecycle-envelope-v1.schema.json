{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-credential-lifecycle-envelope-v1",
  "title": "Owner-lane credential lifecycle envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "authorization_digest", "capture_metadata_digest", "operation_plan_digest", "issuance_outcome_digest", "credential_handle_nonce", "credential_handle_digest", "credential_tuple", "request_budgets", "no_resend", "replacement_lock", "actual_reached_phase", "evidence_root", "recorded_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-credential-lifecycle-envelope-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "authorization_digest": {"$ref": "#/$defs/digest"},
    "capture_metadata_digest": {"$ref": "#/$defs/digest"},
    "operation_plan_digest": {"$ref": "#/$defs/digest"},
    "issuance_outcome_digest": {"$ref": "#/$defs/digest"},
    "credential_handle_nonce": {"type": "string", "pattern": "^[0-9a-f]{32,128}$"},
    "credential_handle_digest": {"$ref": "#/$defs/digest"},
    "credential_tuple": {"$ref": "#/$defs/credentialTuple"},
    "request_budgets": {"$ref": "#/$defs/budgets"},
    "no_resend": {"const": true},
    "replacement_lock": {"const": "locked-until-retired"},
    "actual_reached_phase": {"const": "credential-issued"},
    "evidence_root": {"type": "string", "pattern": "^\\.octon/state/evidence/"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "principal": {"type": "object", "additionalProperties": false, "required": ["login", "id"], "properties": {"login": {"const": "jamesryancooper"}, "id": {"const": 800837}}},
    "permissions": {"type": "array", "minItems": 8, "maxItems": 8, "prefixItems": [
      {"const": {"name": "administration", "level": "write"}},
      {"const": {"name": "actions", "level": "write"}},
      {"const": {"name": "variables", "level": "write"}},
      {"const": {"name": "contents", "level": "write"}},
      {"const": {"name": "pull_requests", "level": "write"}},
      {"const": {"name": "checks", "level": "read"}},
      {"const": {"name": "commit_statuses", "level": "read"}},
      {"const": {"name": "metadata", "level": "read"}}
    ], "items": false},
    "credentialTuple": {"type": "object", "additionalProperties": false, "required": ["credential_class", "token_prefix", "issuer", "resource_owner", "selected_repositories", "public_read_boundary", "permissions", "capture_channel", "api_version", "issuance_attempt_budget", "provider_expiry_days", "local_deadline_seconds"], "properties": {"credential_class": {"const": "fine-grained-personal-access-token"}, "token_prefix": {"const": "github_pat_"}, "issuer": {"const": "github.com"}, "resource_owner": {"$ref": "#/$defs/principal"}, "selected_repositories": {"const": ["jamesryancooper/octon"]}, "public_read_boundary": {"const": "anonymous-equivalent"}, "permissions": {"$ref": "#/$defs/permissions"}, "capture_channel": {"const": "inherited-fd"}, "api_version": {"const": "2026-03-10"}, "issuance_attempt_budget": {"const": 1}, "provider_expiry_days": {"const": 1}, "local_deadline_seconds": {"const": 3600}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["identity_probe", "repository_probe", "revocation", "retirement_probe", "revocation_wait_seconds"], "properties": {"identity_probe": {"const": 1}, "repository_probe": {"const": 1}, "revocation": {"const": 1}, "retirement_probe": {"const": 1}, "revocation_wait_seconds": {"type": "integer", "minimum": 0, "maximum": 300}}}
  }
}
