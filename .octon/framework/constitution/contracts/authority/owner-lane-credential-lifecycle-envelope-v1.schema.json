{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-credential-lifecycle-envelope-v1",
  "title": "Owner-lane credential lifecycle envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "authorization_digest", "issuance_outcome_digest", "manifest_digest", "attestation_digest", "credential_handle_nonce", "credential_handle_digest", "identity_probe_budget", "repository_probe_budget", "revocation_budget", "retirement_probe_budget", "revocation_wait_seconds", "actual_reached_phase", "evidence_root"],
  "properties": {
    "schema_version": {"const": "owner-lane-credential-lifecycle-envelope-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "authorization_digest": {"$ref": "#/$defs/digest"},
    "issuance_outcome_digest": {"$ref": "#/$defs/digest"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "attestation_digest": {"$ref": "#/$defs/digest"},
    "credential_handle_nonce": {"type": "string", "pattern": "^[0-9a-f]{32,128}$"},
    "credential_handle_digest": {"$ref": "#/$defs/digest"},
    "identity_probe_budget": {"const": 1},
    "repository_probe_budget": {"const": 1},
    "revocation_budget": {"const": 1},
    "retirement_probe_budget": {"type": "integer", "minimum": 1, "maximum": 8},
    "revocation_wait_seconds": {"type": "integer", "minimum": 0, "maximum": 900},
    "actual_reached_phase": {"enum": ["credential-issued", "admitted"]},
    "evidence_root": {"type": "string", "pattern": "^\\.octon/state/evidence/"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
