{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-credential-capture-metadata-v1",
  "title": "Owner-lane credential capture metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "authorization_digest", "operation_plan_digest", "capture_source", "issuance_attempts", "issued_at", "provider_expires_at", "local_deadline", "resource_owner", "selected_repositories", "permissions", "no_secret_retained", "recorded_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-credential-capture-metadata-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "authorization_digest": {"$ref": "#/$defs/digest"},
    "operation_plan_digest": {"$ref": "#/$defs/digest"},
    "capture_source": {"const": "github-fine-grained-pat-ui"},
    "issuance_attempts": {"const": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "provider_expires_at": {"type": "string", "format": "date-time"},
    "local_deadline": {"type": "string", "format": "date-time"},
    "resource_owner": {"$ref": "#/$defs/principal"},
    "selected_repositories": {"const": ["jamesryancooper/octon"]},
    "permissions": {"$ref": "#/$defs/permissions"},
    "no_secret_retained": {"const": true},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "principal": {"type": "object", "additionalProperties": false, "required": ["login", "id"], "properties": {"login": {"const": "jamesryancooper"}, "id": {"const": 800837}}},
    "permissions": {"type": "array", "minItems": 8, "maxItems": 8, "prefixItems": [
      {"const": {"name": "administration", "level": "write"}},
      {"const": {"name": "actions", "level": "write"}},
      {"const": {"name": "variables", "level": "write"}},
      {"const": {"name": "contents", "level": "write"}},
      {"const": {"name": "pull_requests", "level": "write"}},
      {"const": {"name": "checks", "level": "read"}},
      {"const": {"name": "commit_statuses", "level": "read"}},
      {"const": {"name": "metadata", "level": "read"}}
    ], "items": false}
  }
}
