{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-credential-admission-authorization-v1",
  "title": "Owner-lane credential admission authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "accepted_review_digest", "run_id", "repository", "base_sha", "candidate_sha", "candidate_tree", "principal", "credential_tuple", "manifest_digest", "operation_digest", "evidence_root", "one_attempt_lock", "authorized_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-credential-admission-authorization-v1"},
    "authorization_id": {"type": "string", "minLength": 1},
    "accepted_review_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "repository": {"const": "jamesryancooper/octon"},
    "base_sha": {"$ref": "#/$defs/gitSha"},
    "candidate_sha": {"$ref": "#/$defs/gitSha"},
    "candidate_tree": {"$ref": "#/$defs/gitSha"},
    "principal": {"$ref": "#/$defs/principal"},
    "credential_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_class", "issuer", "capture_channel", "api_version"],
      "properties": {
        "credential_class": {"const": "fine-grained-personal-access-token"},
        "issuer": {"const": "github.com"},
        "capture_channel": {"const": "inherited-fd"},
        "api_version": {"const": "2026-03-10"}
      }
    },
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "operation_digest": {"$ref": "#/$defs/digest"},
    "evidence_root": {"type": "string", "pattern": "^\\.octon/state/evidence/"},
    "one_attempt_lock": {"const": "locked"},
    "authorized_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "principal": {"type": "object", "additionalProperties": false, "required": ["login", "id"], "properties": {"login": {"type": "string", "minLength": 1}, "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}}
  }
}
