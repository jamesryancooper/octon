{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-credential-admission-authorization-v1",
  "title": "Owner-lane credential admission authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "accepted_review_digest", "run_id", "repository", "base_sha", "candidate_sha", "candidate_tree", "principal", "credential_tuple", "operation_plan_digest", "evidence_root", "request_budgets", "allowed_admission_probes", "no_resend", "one_attempt_lock", "replacement_lock", "authorized_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-credential-admission-authorization-v1"},
    "authorization_id": {"type": "string", "minLength": 1},
    "accepted_review_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "repository": {"const": "jamesryancooper/octon"},
    "base_sha": {"$ref": "#/$defs/gitSha"},
    "candidate_sha": {"$ref": "#/$defs/gitSha"},
    "candidate_tree": {"$ref": "#/$defs/gitSha"},
    "principal": {"$ref": "#/$defs/principal"},
    "credential_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_class", "token_prefix", "issuer", "resource_owner", "selected_repositories", "public_read_boundary", "permissions", "capture_channel", "api_version", "issuance_attempt_budget", "provider_expiry_days", "local_deadline_seconds"],
      "properties": {
        "credential_class": {"const": "fine-grained-personal-access-token"},
        "token_prefix": {"const": "github_pat_"},
        "issuer": {"const": "github.com"},
        "resource_owner": {"$ref": "#/$defs/principal"},
        "selected_repositories": {"const": ["jamesryancooper/octon"]},
        "public_read_boundary": {"const": "anonymous-equivalent"},
        "permissions": {"$ref": "#/$defs/permissions"},
        "capture_channel": {"const": "inherited-fd"},
        "api_version": {"const": "2026-03-10"},
        "issuance_attempt_budget": {"const": 1},
        "provider_expiry_days": {"const": 1},
        "local_deadline_seconds": {"const": 3600}
      }
    },
    "operation_plan_digest": {"$ref": "#/$defs/digest"},
    "evidence_root": {"type": "string", "pattern": "^\\.octon/state/evidence/"},
    "request_budgets": {"$ref": "#/$defs/budgets"},
    "allowed_admission_probes": {"const": ["identity", "repository"]},
    "no_resend": {"const": true},
    "one_attempt_lock": {"const": "locked"},
    "replacement_lock": {"const": "locked-until-retired"},
    "authorized_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "principal": {"type": "object", "additionalProperties": false, "required": ["login", "id"], "properties": {"login": {"const": "jamesryancooper"}, "id": {"const": 800837}}},
    "permission": {"type": "object", "additionalProperties": false, "required": ["name", "level"], "properties": {"name": {"enum": ["administration", "actions", "variables", "contents", "pull_requests", "checks", "commit_statuses", "metadata"]}, "level": {"enum": ["read", "write"]}}},
    "permissions": {"type": "array", "minItems": 8, "maxItems": 8, "prefixItems": [
      {"const": {"name": "administration", "level": "write"}},
      {"const": {"name": "actions", "level": "write"}},
      {"const": {"name": "variables", "level": "write"}},
      {"const": {"name": "contents", "level": "write"}},
      {"const": {"name": "pull_requests", "level": "write"}},
      {"const": {"name": "checks", "level": "read"}},
      {"const": {"name": "commit_statuses", "level": "read"}},
      {"const": {"name": "metadata", "level": "read"}}
    ], "items": false},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["identity_probe", "repository_probe", "revocation", "retirement_probe", "revocation_wait_seconds"], "properties": {"identity_probe": {"const": 1}, "repository_probe": {"const": 1}, "revocation": {"const": 1}, "retirement_probe": {"const": 1}, "revocation_wait_seconds": {"type": "integer", "minimum": 0, "maximum": 300}}}
  }
}
