{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-operation-construction-receipt-v1",
  "title": "Owner-lane operation construction receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "manifest_digest", "attestation_digest", "completed_prefix_digest", "operation_id", "sequence", "template_digest", "binding_digest", "resolved_request_digest", "normalized_template_digest", "canonical_pr_number", "normalized", "constructed_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-operation-construction-receipt-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "attestation_digest": {"$ref": "#/$defs/digest"},
    "completed_prefix_digest": {"$ref": "#/$defs/digest"},
    "operation_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 32},
    "template_digest": {"$ref": "#/$defs/digest"},
    "binding_digest": {"$ref": "#/$defs/digest"},
    "resolved_request_digest": {"$ref": "#/$defs/digest"},
    "normalized_template_digest": {"$ref": "#/$defs/digest"},
    "canonical_pr_number": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "normalized": {"const": true},
    "constructed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
