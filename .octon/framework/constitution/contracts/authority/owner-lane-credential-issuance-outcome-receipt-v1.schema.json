{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-credential-issuance-outcome-receipt-v1",
  "title": "Owner-lane credential issuance outcome receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "authorization_digest", "issued", "issuance_attempts", "issuer", "principal", "nonce_salted_handle_digest", "header_digest", "revocation_body_digest", "no_secret_retained", "recorded_at"],
  "properties": {
    "schema_version": {"const": "owner-lane-credential-issuance-outcome-receipt-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "authorization_digest": {"$ref": "#/$defs/digest"},
    "issued": {"const": true},
    "issuance_attempts": {"const": 1},
    "issuer": {"const": "github.com"},
    "principal": {"$ref": "#/$defs/principal"},
    "nonce_salted_handle_digest": {"$ref": "#/$defs/digest"},
    "header_digest": {"$ref": "#/$defs/digest"},
    "revocation_body_digest": {"$ref": "#/$defs/digest"},
    "no_secret_retained": {"const": true},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "principal": {"type": "object", "additionalProperties": false, "required": ["login", "id"], "properties": {"login": {"type": "string", "minLength": 1}, "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}}
  }
}
