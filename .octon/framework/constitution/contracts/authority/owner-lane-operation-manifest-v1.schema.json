{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon://contracts/authority/owner-lane-operation-manifest-v1",
  "title": "Owner-lane operation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "repository", "base_sha", "head_sha", "candidate_tree", "attestation_digest", "operation_digest", "one_attempt_lock", "tools", "operations"],
  "properties": {
    "schema_version": {"const": "owner-lane-operation-manifest-v1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "repository": {"const": "jamesryancooper/octon"},
    "base_sha": {"$ref": "#/$defs/gitSha"},
    "head_sha": {"$ref": "#/$defs/gitSha"},
    "candidate_tree": {"$ref": "#/$defs/gitSha"},
    "attestation_digest": {"$ref": "#/$defs/digest"},
    "operation_digest": {"$ref": "#/$defs/digest"},
    "one_attempt_lock": {"const": "locked"},
    "tools": {
      "type": "object", "additionalProperties": false,
      "required": ["curl", "git", "mkfifo", "askpass"],
      "properties": {"curl": {"$ref": "#/$defs/tool"}, "git": {"$ref": "#/$defs/tool"}, "mkfifo": {"$ref": "#/$defs/tool"}, "askpass": {"$ref": "#/$defs/tool"}}
    },
    "operations": {"type": "array", "minItems": 5, "maxItems": 32, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tool": {"type": "object", "additionalProperties": false, "required": ["canonical_path", "sha256"], "properties": {"canonical_path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sequence", "kind", "method", "url", "authenticated", "no_resend", "expected_statuses", "request_digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 32},
        "kind": {"enum": ["identity_probe", "repository_probe", "workflow_disable", "workflow_run_cancel", "git_push", "pull_request_create", "marker_create", "ruleset_update", "check_trigger", "pull_request_merge", "main_post_read", "credential_revoke", "terminal_identity_probe"]},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "PUSH"]},
        "url": {"type": "string", "pattern": "^https://(api\\.github\\.com|github\\.com)/"},
        "authenticated": {"type": "boolean"},
        "no_resend": {"const": true},
        "expected_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 100, "maximum": 599}},
        "body": {},
        "refspec": {"type": "string", "minLength": 1},
        "observation_digest": {"$ref": "#/$defs/digest"},
        "request_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
