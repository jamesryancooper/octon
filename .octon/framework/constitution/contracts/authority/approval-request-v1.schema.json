{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/framework/constitution/contracts/authority/approval-request-v1.schema.json",
  "title": "Octon Approval Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "status",
    "target_id",
    "action_type",
    "workflow_mode",
    "support_tier",
    "reason_codes",
    "required_evidence",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "authority-approval-request-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pending", "granted", "staged", "denied", "expired"]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "action_type": {
      "type": "string",
      "minLength": 1
    },
    "workflow_mode": {
      "type": "string",
      "enum": ["autonomous", "role-mediated", "human-only"]
    },
    "support_tier": {
      "type": "string",
      "minLength": 1
    },
    "quorum_policy_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownership_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reversibility_class": {
      "type": ["string", "null"]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "typed_exception_boundary": {
      "$ref": "#/$defs/typed_exception_boundary"
    },
    "authority_provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_authority_source": {
      "type": ["string", "null"],
      "not": {
        "enum": [
          "generated-output",
          "generated-effective",
          "generated-projection",
          "read-model",
          "operator-read-model"
        ]
      }
    },
    "projection_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projection_source"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "typed_exception_boundary": {
      "type": ["string", "null"],
      "enum": [
        "scope-expansion",
        "policy-override",
        "unresolved-risk-acceptance",
        "governance-mutation",
        "contradictory-evidence-resolution",
        "stale-evidence-acceptance",
        "authority-ambiguity",
        "unsafe-resume",
        "external-irreversible-effect",
        null
      ]
    },
    "projection_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
