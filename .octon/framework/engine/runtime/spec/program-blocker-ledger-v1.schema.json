{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octon-program-blocker-ledger-v1",
  "title": "Octon Program Blocker Ledger",
  "description": "Digest-bound compact blocker ledger for proposal-program recovery. It is retained evidence/read-model material and never authorizes execution or replaces child-owned receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "run_id",
    "lifecycle_id",
    "target",
    "producer",
    "generated_at",
    "authority_boundary",
    "default_reader_preference",
    "token_ceiling",
    "blocker_count",
    "blockers",
    "source_refs",
    "validation_binding",
    "failure_behavior"
  ],
  "properties": {
    "schema_version": { "const": "octon-program-blocker-ledger-v1" },
    "schema_ref": {
      "const": ".octon/framework/engine/runtime/spec/program-blocker-ledger-v1.schema.json"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "lifecycle_id": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "producer": { "const": "lifecycle-program-controller" },
    "generated_at": { "type": "string", "minLength": 1 },
    "authority_boundary": { "$ref": "#/$defs/authority_boundary" },
    "default_reader_preference": { "type": "string", "minLength": 1 },
    "token_ceiling": { "type": "integer", "minimum": 0 },
    "blocker_count": { "type": "integer", "minimum": 0 },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "source_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_ref" }
    },
    "validation_binding": { "$ref": "#/$defs/validation_binding" },
    "failure_behavior": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replaces_source_evidence",
        "authorizes_execution",
        "proposal_input_authority",
        "generated_output_authority",
        "raw_evidence_retained"
      ],
      "properties": {
        "replaces_source_evidence": { "const": false },
        "authorizes_execution": { "const": false },
        "proposal_input_authority": { "const": "non-authoritative" },
        "generated_output_authority": { "const": "derived-only" },
        "raw_evidence_retained": { "const": true }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_role", "artifact_ref", "sha256", "required"],
      "properties": {
        "artifact_role": { "type": "string", "minLength": 1 },
        "artifact_ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "required": { "type": "boolean" }
      }
    },
    "validation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_event_index",
        "child_registry_digest",
        "failure_behavior"
      ],
      "properties": {
        "status": { "const": "digest-bound" },
        "source_event_index": { "type": "integer", "minimum": 0 },
        "source_event_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_event_log_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "child_registry_digest": { "type": "string", "minLength": 1 },
        "failure_behavior": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_id",
        "scope",
        "route_id",
        "blocker_class",
        "blocker_message",
        "latest_transition",
        "current_fingerprint",
        "recovery_budget",
        "evidence_refs",
        "authority_boundary_notice"
      ],
      "properties": {
        "blocker_id": { "type": "string", "pattern": "^blocker-[0-9a-f]{16}$" },
        "scope": { "enum": ["program", "child"] },
        "child_id": { "type": "string", "minLength": 1 },
        "route_id": { "type": "string", "minLength": 1 },
        "blocker_class": { "type": "string", "minLength": 1 },
        "blocker_message": { "type": "string", "minLength": 1 },
        "latest_transition": { "type": "string", "minLength": 1 },
        "prior_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "current_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "recovery_budget": { "$ref": "#/$defs/recovery_budget" },
        "recovery_route": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "authority_boundary_notice": { "type": "string", "minLength": 1 }
      }
    },
    "recovery_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts_used",
        "max_attempts",
        "remaining_attempts",
        "exhausted"
      ],
      "properties": {
        "attempts_used": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 0 },
        "remaining_attempts": { "type": "integer", "minimum": 0 },
        "exhausted": { "type": "boolean" }
      }
    }
  }
}
