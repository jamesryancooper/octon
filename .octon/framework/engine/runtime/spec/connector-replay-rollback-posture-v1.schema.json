{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/engine/runtime/spec/connector-replay-rollback-posture-v1.schema.json",
  "title": "Connector Replay Rollback Posture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replayability",
    "rollback_compensation_posture",
    "irreversible_external_effect_route",
    "machine_delegation_allowed_for_irreversible_external_effects",
    "generated_outputs_authorize_replay_or_rollback"
  ],
  "properties": {
    "schema_version": { "const": "connector-replay-rollback-posture-v1" },
    "replayability": { "type": "string", "minLength": 1 },
    "replay_manifest_refs": { "type": "array", "items": { "type": "string" } },
    "rollback_compensation_posture": { "type": "string", "minLength": 1 },
    "compensation_plan_refs": { "type": "array", "items": { "type": "string" } },
    "irreversible_external_effect_route": {
      "type": "string",
      "enum": ["deny", "human_required", "break_glass_only", "deferred"]
    },
    "machine_delegation_allowed_for_irreversible_external_effects": { "const": false },
    "generated_outputs_authorize_replay_or_rollback": { "const": false }
  }
}
