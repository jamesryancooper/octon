{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/engine/runtime/spec/token-budget-ledger-v1.schema.json",
  "title": "Token Budget Ledger v1",
  "description": "Retained measurement ledger for lifecycle token estimates and provider usage when available. It is evidence/read-model material and never authorizes execution or replaces source evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "ledger_id",
    "run_id",
    "lifecycle_id",
    "route_id",
    "ledger_scope",
    "produced_by",
    "ledger_role",
    "token_generation_mode",
    "provider_usage",
    "token_summary",
    "levels",
    "source_records",
    "regression_guard",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": { "const": "token-budget-ledger-v1" },
    "schema_ref": {
      "const": ".octon/framework/engine/runtime/spec/token-budget-ledger-v1.schema.json"
    },
    "ledger_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "lifecycle_id": { "type": "string", "minLength": 1 },
    "route_id": { "type": "string", "minLength": 1 },
    "phase_id": { "type": "string", "minLength": 1 },
    "ledger_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "target_ref", "evidence_root_ref"],
      "properties": {
        "level": { "type": "string", "minLength": 1 },
        "parent_run_id": { "type": "string", "minLength": 1 },
        "child_id": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string", "minLength": 1 },
        "evidence_root_ref": { "type": "string", "minLength": 1 }
      }
    },
    "produced_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "recorded_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "const": "token-budget-ledger-v1" },
        "recorded_at": { "type": "string", "minLength": 1 }
      }
    },
    "ledger_role": {
      "enum": [
        "retained-token-measurement-evidence-not-authority",
        "retained-program-token-measurement-evidence-not-authority"
      ]
    },
    "token_generation_mode": {
      "const": "deterministic-byte-estimate-provider-usage-when-present"
    },
    "provider_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "usage_mismatch_detected", "notes"],
      "properties": {
        "status": { "enum": ["available", "not_available", "missing"] },
        "provider_usage_ref": { "type": "string", "minLength": 1 },
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "context_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "tool_output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "usage_mismatch_detected": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "token_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated_total_tokens",
        "model_visible_estimated_tokens",
        "prompt_estimated_tokens",
        "context_estimated_tokens",
        "completion_estimated_tokens",
        "tool_output_estimated_tokens",
        "evidence_estimated_tokens",
        "repeated_source_percentage",
        "repeated_source_token_estimate",
        "prompt_boilerplate_percentage",
        "prompt_boilerplate_token_estimate",
        "generated_state_reread_count",
        "raw_log_reread_count",
        "high_reasoning_call_count"
      ],
      "properties": {
        "estimated_total_tokens": { "type": "integer", "minimum": 0 },
        "model_visible_estimated_tokens": { "type": "integer", "minimum": 0 },
        "prompt_estimated_tokens": { "type": "integer", "minimum": 0 },
        "context_estimated_tokens": { "type": "integer", "minimum": 0 },
        "completion_estimated_tokens": { "type": "integer", "minimum": 0 },
        "tool_output_estimated_tokens": { "type": "integer", "minimum": 0 },
        "evidence_estimated_tokens": { "type": "integer", "minimum": 0 },
        "repeated_source_percentage": { "type": "number", "minimum": 0 },
        "repeated_source_token_estimate": { "type": "integer", "minimum": 0 },
        "prompt_boilerplate_percentage": { "type": "number", "minimum": 0 },
        "prompt_boilerplate_token_estimate": { "type": "integer", "minimum": 0 },
        "generated_state_reread_count": { "type": "integer", "minimum": 0 },
        "raw_log_reread_count": { "type": "integer", "minimum": 0 },
        "high_reasoning_call_count": { "type": "integer", "minimum": 0 }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "subject_id", "estimated_tokens", "source_count", "notes"],
        "properties": {
          "level": { "enum": ["parent", "child", "stage", "source", "model"] },
          "subject_id": { "type": "string", "minLength": 1 },
          "estimated_tokens": { "type": "integer", "minimum": 0 },
          "source_count": { "type": "integer", "minimum": 0 },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "sha256",
          "bytes",
          "estimated_tokens",
          "source_class",
          "model_visible",
          "inclusion_mode"
        ],
        "properties": {
          "source_ref": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "estimated_tokens": { "type": "integer", "minimum": 0 },
          "source_class": { "type": "string", "minLength": 1 },
          "model_visible": { "type": "boolean" },
          "inclusion_mode": { "enum": ["full", "digest-bound"] }
        }
      }
    },
    "regression_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_ref",
        "candidate_ref",
        "avoidable_regression_threshold_percent",
        "status",
        "notes"
      ],
      "properties": {
        "baseline_ref": { "type": ["string", "null"] },
        "candidate_ref": { "type": "string", "minLength": 1 },
        "avoidable_regression_threshold_percent": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "minLength": 1 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "replaces_source_evidence",
        "authorizes_execution",
        "raw_evidence_retained",
        "proposal_input_authority",
        "generated_output_authority",
        "failure_behavior"
      ],
      "properties": {
        "artifact_class": { "const": "retained-evidence-read-model" },
        "replaces_source_evidence": { "const": false },
        "authorizes_execution": { "const": false },
        "raw_evidence_retained": { "const": true },
        "proposal_input_authority": { "const": "non-authoritative" },
        "generated_output_authority": { "const": "derived-only" },
        "failure_behavior": {
          "const": "fail-closed-for-regression-claims-not-for-authorization"
        }
      }
    }
  }
}
