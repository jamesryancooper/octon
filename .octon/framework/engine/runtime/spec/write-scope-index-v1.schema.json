{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/engine/runtime/spec/write-scope-index-v1.schema.json",
  "title": "Write Scope Index v1",
  "description": "Generated advisory index of proposal-program child write scopes and promotion target coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "artifact_kind",
    "artifact_ref",
    "authority_status",
    "producer",
    "generated_at",
    "source_refs",
    "authority_boundary",
    "freshness",
    "reader_preferences",
    "program_ref",
    "child_count",
    "children",
    "target_family_summary",
    "failure_behavior"
  ],
  "properties": {
    "schema_version": { "const": "octon-write-scope-index-v1" },
    "schema_ref": { "const": ".octon/framework/engine/runtime/spec/write-scope-index-v1.schema.json" },
    "artifact_kind": { "const": "write-scope-index" },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "authority_status": { "const": "generated-derived-read-model-not-authority" },
    "producer": { "$ref": "repo-authority-graph-v1.schema.json#/$defs/producer" },
    "generated_at": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "repo-authority-graph-v1.schema.json#/$defs/source_ref" } },
    "authority_boundary": { "$ref": "repo-authority-graph-v1.schema.json#/$defs/authority_boundary" },
    "freshness": { "$ref": "repo-authority-graph-v1.schema.json#/$defs/freshness" },
    "reader_preferences": { "$ref": "repo-authority-graph-v1.schema.json#/$defs/reader_preferences" },
    "program_ref": { "type": "string", "minLength": 1 },
    "child_count": { "type": "integer", "minimum": 0 },
    "children": { "type": "array", "items": { "$ref": "#/$defs/child_entry" } },
    "target_family_summary": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "failure_behavior": { "$ref": "repo-authority-graph-v1.schema.json#/$defs/failure_behavior" }
  },
  "$defs": {
    "child_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_id",
        "path",
        "phase_id",
        "group_id",
        "dependencies",
        "write_scope_count",
        "write_scopes",
        "promotion_target_count",
        "promotion_targets",
        "coverage_status"
      ],
      "properties": {
        "child_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "phase_id": { "type": "string", "minLength": 1 },
        "group_id": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "model_route_default": { "type": "string" },
        "token_ceiling": { "type": "string" },
        "write_scope_count": { "type": "integer", "minimum": 0 },
        "write_scopes": { "type": "array", "items": { "$ref": "#/$defs/scope_entry" } },
        "promotion_target_count": { "type": "integer", "minimum": 0 },
        "promotion_targets": { "type": "array", "items": { "$ref": "#/$defs/scope_entry" } },
        "coverage_status": { "type": "string", "minLength": 1 }
      }
    },
    "scope_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "target_family",
        "authority_posture",
        "authored_authority",
        "boundary_status",
        "risk_flags"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "target_family": { "type": "string", "minLength": 1 },
        "authority_posture": { "type": "string", "minLength": 1 },
        "authored_authority": { "type": "boolean" },
        "boundary_status": { "type": "string", "minLength": 1 },
        "risk_flags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
