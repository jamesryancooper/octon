{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/framework/product/contracts/branch-cleanup-authorization-v1.schema.json",
  "title": "Octon SI-00 Branch Cleanup Denial Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "authorization_result",
    "denial_reason",
    "containment_state",
    "selected_route",
    "requested_target_lifecycle_outcome",
    "actual_lifecycle_outcome",
    "remote",
    "base_branch",
    "source_branch",
    "candidate_id",
    "requested_landed_ref",
    "observed_local_source_ref",
    "observed_remote_source_ref",
    "observed_base_ref",
    "rollback_handle",
    "rollback_handles",
    "delete_remote_requested",
    "remove_worktrees_requested",
    "sync_main_requested",
    "mutation_permitted",
    "host_controls_not_bypassed",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "branch-cleanup-authorization-v1" },
    "authorization_id": { "type": "string", "minLength": 1 },
    "authorization_result": { "const": "denied" },
    "denial_reason": { "const": "RP00_CONTAINMENT_CLEANUP_DISABLED" },
    "containment_state": { "const": "SI-00" },
    "selected_route": {
      "type": "string",
      "enum": ["branch-no-pr", "branch-pr"]
    },
    "requested_target_lifecycle_outcome": { "const": "cleaned" },
    "actual_lifecycle_outcome": { "const": "preserved" },
    "remote": { "type": "string", "minLength": 1 },
    "base_branch": { "type": "string", "minLength": 1 },
    "source_branch": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "requested_landed_ref": { "type": "string", "minLength": 1 },
    "observed_local_source_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "observed_remote_source_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "observed_base_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "rollback_handle": { "type": "string", "minLength": 1 },
    "rollback_handles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "delete_remote_requested": { "type": "boolean" },
    "remove_worktrees_requested": { "type": "boolean" },
    "sync_main_requested": { "type": "boolean" },
    "mutation_permitted": { "const": false },
    "host_controls_not_bypassed": { "const": true },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
