{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/framework/product/contracts/change-receipt-v1.schema.json",
  "title": "Octon Change Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "selected_route",
    "target_lifecycle_outcome",
    "lifecycle_outcome",
    "outcome_intent",
    "intent",
    "scope",
    "validation_evidence_refs",
    "durable_history",
    "integration_status",
    "publication_status",
    "cleanup_status",
    "rollback_handle",
    "closeout_outcome",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "change-receipt-v1"
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_route": {
      "type": "string",
      "enum": [
        "direct-main",
        "branch-no-pr",
        "branch-pr",
        "stage-only-escalate"
      ]
    },
    "operator_requested_route": {
      "type": "string",
      "enum": [
        "direct-main",
        "branch-no-pr",
        "branch-pr",
        "stage-only-escalate"
      ]
    },
    "initial_route": {
      "type": "string",
      "description": "Initial route selected before any authority-backed route transition.",
      "enum": [
        "direct-main",
        "branch-no-pr",
        "branch-pr",
        "stage-only-escalate"
      ]
    },
    "route_transition_reason": {
      "type": "string",
      "minLength": 1
    },
    "route_transition_authority": {
      "type": "string",
      "enum": [
        "explicit-operator-reroute",
        "policy-reroute-after-new-evidence",
        "none"
      ]
    },
    "route_transition_authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "route_transition_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "branch_pr_predicate": {
      "type": "string",
      "enum": [
        "explicit-operator-pr-request",
        "existing-pr-context",
        "release-automation",
        "preview-publication-required",
        "hosted-review-required",
        "external-signoff-required",
        "protected-or-high-impact-remote-review-required",
        "provider-ruleset-requires-pr-for-requested-pr-backed-landing"
      ]
    },
    "branch_pr_predicate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate",
        "requirement_ref",
        "evidence_refs",
        "branch_no_pr_rejection_reason"
      ],
      "properties": {
        "predicate": {
          "type": "string",
          "enum": [
            "explicit-operator-pr-request",
            "existing-pr-context",
            "release-automation",
            "preview-publication-required",
            "hosted-review-required",
            "external-signoff-required",
            "protected-or-high-impact-remote-review-required",
            "provider-ruleset-requires-pr-for-requested-pr-backed-landing"
          ]
        },
        "requirement_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "branch_no_pr_rejection_reason": {
          "type": "string",
          "minLength": 1
        },
        "operator_request_ref": {
          "type": "string",
          "minLength": 1
        },
        "provider_ruleset_ref": {
          "type": "string",
          "minLength": 1
        },
        "existing_pr_or_review_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_classification_ref": {
          "type": "string",
          "minLength": 1
        },
        "governing_review_requirement_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "predicate": { "const": "explicit-operator-pr-request" }
            },
            "required": ["predicate"]
          },
          "then": {
            "required": ["operator_request_ref"]
          }
        },
        {
          "if": {
            "properties": {
              "predicate": { "const": "existing-pr-context" }
            },
            "required": ["predicate"]
          },
          "then": {
            "required": ["existing_pr_or_review_ref"]
          }
        },
        {
          "if": {
            "properties": {
              "predicate": { "const": "provider-ruleset-requires-pr-for-requested-pr-backed-landing" }
            },
            "required": ["predicate"]
          },
          "then": {
            "required": ["provider_ruleset_ref"]
          }
        },
        {
          "if": {
            "properties": {
              "predicate": { "const": "protected-or-high-impact-remote-review-required" }
            },
            "required": ["predicate"]
          },
          "then": {
            "required": [
              "scope_classification_ref",
              "governing_review_requirement_ref"
            ]
          }
        }
      ]
    },
    "target_lifecycle_outcome": {
      "type": "string",
      "default": "cleaned",
      "description": "Requested lifecycle target. If the operator only asks to close out a Change or worktree and does not name a narrower target, resolve this to cleaned before writing the receipt.",
      "enum": [
        "preserved",
        "branch-local-complete",
        "published-branch",
        "published",
        "ready",
        "landed",
        "cleaned",
        "blocked",
        "escalated",
        "denied"
      ]
    },
    "lifecycle_outcome": {
      "type": "string",
      "enum": [
        "preserved",
        "branch-local-complete",
        "published-branch",
        "published",
        "ready",
        "landed",
        "cleaned",
        "deferred",
        "blocked",
        "escalated",
        "denied"
      ]
    },
    "outcome_intent": {
      "type": "string",
      "enum": [
        "preserve-only",
        "local-only",
        "handoff-only",
        "attempt-landing",
        "attempt-cleaned-closeout",
        "record-blocker-only",
        "pr-publication",
        "pr-ready",
        "pr-landing",
        "direct-main-landing"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "summary": { "type": "string" },
        "touched_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "diff_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_branch_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_branch_ref": {
      "type": "string",
      "minLength": 1
    },
    "remote_branch_ref": {
      "type": "string",
      "minLength": 1
    },
    "landing_authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "cleanup_authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "landing_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "not_attempted",
            "eligible",
            "attempted",
            "blocked",
            "succeeded",
            "failed"
          ]
        },
        "provider_ruleset_ref": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string", "minLength": 1 },
        "blocker_reason": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hosted_landing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote",
        "target_branch",
        "source_branch",
        "source_ref",
        "target_pre_ref",
        "target_post_ref",
        "validated_ref",
        "required_check_refs",
        "provider_ruleset_ref",
        "fast_forward_only"
      ],
      "properties": {
        "remote": { "type": "string", "minLength": 1 },
        "target_branch": { "type": "string", "minLength": 1 },
        "source_branch": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "target_pre_ref": { "type": "string", "minLength": 1 },
        "target_post_ref": { "type": "string", "minLength": 1 },
        "validated_ref": { "type": "string", "minLength": 1 },
        "required_check_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "provider_ruleset_ref": { "type": "string", "minLength": 1 },
        "push_refspec": { "type": "string", "minLength": 1 },
        "fast_forward_only": { "const": true }
      }
    },
    "landed_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_branch_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_branch_ref",
        "landed_ref",
        "origin_main_ref",
        "integrated",
        "evidence_refs"
      ],
      "properties": {
        "source_branch_ref": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "landed_ref": { "type": "string", "minLength": 1 },
        "origin_main_ref": { "type": "string", "minLength": 1 },
        "integrated": { "const": true },
        "method": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "not_landed_reason": {
      "type": "string",
      "minLength": 1
    },
    "not_cleaned_reason": {
      "type": "string",
      "minLength": 1
    },
    "landing_stop_reason": {
      "type": "string",
      "description": "Structured reason a target of landed or cleaned stopped before origin/main landing.",
      "enum": [
        "governance_authorization_missing",
        "governance_authorization_malformed",
        "governance_authorization_stale",
        "governance_authorization_denied",
        "runtime_approval_denied",
        "provider_policy_blocked",
        "hosted_checks_pending",
        "hosted_checks_failed",
        "source_branch_stale",
        "fast_forward_blocked",
        "landing_execution_failed",
        "external_blocker"
      ]
    },
    "cleanup_stop_reason": {
      "type": "string",
      "description": "Structured reason a target of cleaned stopped before completed cleanup.",
      "enum": [
        "landing_not_completed",
        "governance_authorization_missing",
        "governance_authorization_malformed",
        "governance_authorization_stale",
        "governance_authorization_denied",
        "runtime_approval_denied",
        "provider_policy_blocked",
        "cleanup_unsafe",
        "cleanup_deferred_by_operator",
        "local_main_sync_missing",
        "containment_missing",
        "open_pr_exists",
        "protected_branch",
        "rollback_posture_missing",
        "cleanup_execution_failed",
        "external_blocker"
      ]
    },
    "main_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_main_ref",
        "origin_main_ref",
        "landed_ref",
        "aligned"
      ],
      "properties": {
        "local_main_ref": { "type": "string", "minLength": 1 },
        "origin_main_ref": { "type": "string", "minLength": 1 },
        "landed_ref": { "type": "string", "minLength": 1 },
        "aligned": { "const": true },
        "origin_fetch_evidence_ref": { "type": "string", "minLength": 1 },
        "local_main_sync_evidence_ref": { "type": "string", "minLength": 1 },
        "origin_main_contains_landed_ref": { "const": true },
        "local_main_contains_landed_ref": { "const": true },
        "verification_ref": { "type": "string", "minLength": 1 }
      }
    },
    "integration_method": {
      "type": "string",
      "enum": [
        "direct-commit",
        "fast-forward",
        "merge-commit",
        "squash",
        "cherry-pick",
        "github-merge",
        "manual",
        "not-applicable"
      ]
    },
    "integration_status": {
      "type": "string",
      "enum": [
        "not_landed",
        "landed",
        "not_applicable"
      ]
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "none",
        "pushed-branch",
        "hosted-main-updated",
        "pr-opened",
        "pr-ready",
        "pr-merged",
        "not_applicable"
      ]
    },
    "cleanup_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "pending",
        "completed",
        "deferred"
      ]
    },
    "cleanup_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "publishable_evidence_receipt_refs": {
      "type": "array",
      "description": "Repo-publishable receipts that summarize or attest the local evidence supporting a hosted/shared closeout claim without publishing private raw evidence.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_ref",
          "schema_ref",
          "disclosure_tier",
          "claim_scope_ref",
          "receipt_digest",
          "raw_evidence_not_published"
        ],
        "properties": {
          "receipt_ref": {
            "type": "string",
            "minLength": 1
          },
          "schema_ref": {
            "const": ".octon/framework/constitution/contracts/retention/publishable-evidence-receipt-v1.schema.json"
          },
          "disclosure_tier": {
            "const": "repo-publishable"
          },
          "claim_scope_ref": {
            "type": "string",
            "minLength": 1
          },
          "receipt_digest": {
            "$ref": "#/$defs/sha256Digest"
          },
          "raw_evidence_not_published": {
            "const": true
          },
          "local_evidence_digest_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sha256Digest"
            }
          }
        }
      }
    },
    "source_branch_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_applicable", "pending", "completed", "deferred", "skipped", "blocked"]
        },
        "local_branch": { "type": "string", "minLength": 1 },
        "remote_branch": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "blocker_reason": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stateful_closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_machine_version",
        "initial_inventory_ref",
        "residue_classification_ref",
        "phase_exit_refs",
        "cleanup_decision_refs",
        "safe_cleanup_evidence_class",
        "final_verification_ref"
      ],
      "properties": {
        "state_machine_version": {
          "const": "change-closeout-state-machine-v1"
        },
        "initial_inventory_ref": {
          "type": "string",
          "minLength": 1
        },
        "residue_classification_ref": {
          "type": "string",
          "minLength": 1
        },
        "phase_exit_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cleanup_decision_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "safe_cleanup_evidence_class": {
          "type": "string",
          "enum": [
            "origin-main-containment",
            "patch-equivalence",
            "tracked-replacement",
            "explicit-ignored-local-residue",
            "validator-proof",
            "not-applicable"
          ]
        },
        "hosted_landing_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "branch_cleanup_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "final_verification_ref": {
          "type": "string",
          "minLength": 1
        },
        "escalation_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "external_blocker_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "validation_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "review_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "review_waiver_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "durable_history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["commit", "patch", "checkpoint", "branch", "pr"]
        },
        "ref": { "type": "string", "minLength": 1 },
        "pr_url": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "rollback_handle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["revert-commit", "patch-reversal", "checkpoint-restore", "discard-branch", "manual-instructions"]
        },
        "ref": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string" }
      }
    },
    "closeout_outcome": {
      "type": "string",
      "enum": ["completed", "continued", "stage_only", "blocked", "escalated", "denied"]
    },
    "remaining_blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "closeout_outcome": { "const": "completed" }
        },
        "required": ["closeout_outcome"]
      },
      "then": {
        "required": ["stateful_closeout"]
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_outcome": { "const": "cleaned" }
        },
        "required": ["lifecycle_outcome"]
      },
      "then": {
        "required": ["stateful_closeout"]
      }
    },
    {
      "if": { "properties": { "selected_route": { "const": "branch-pr" } } },
      "then": {
        "required": [
          "source_branch_ref",
          "branch_pr_predicate",
          "branch_pr_predicate_evidence"
        ],
        "properties": {
          "target_lifecycle_outcome": {
            "enum": ["preserved", "published", "ready", "landed", "cleaned", "blocked", "escalated", "denied"]
          },
          "lifecycle_outcome": {
            "enum": ["preserved", "published", "ready", "landed", "cleaned", "deferred", "blocked", "escalated", "denied"]
          },
          "publication_status": {
            "enum": ["none", "pr-opened", "pr-ready", "pr-merged"]
          }
        }
      }
    },
    {
      "if": { "properties": { "selected_route": { "const": "branch-no-pr" } } },
      "then": {
        "required": ["source_branch_ref"],
        "properties": {
          "target_lifecycle_outcome": {
            "enum": ["preserved", "branch-local-complete", "published-branch", "landed", "cleaned", "blocked", "escalated", "denied"]
          },
          "lifecycle_outcome": {
            "enum": ["preserved", "branch-local-complete", "published-branch", "landed", "cleaned", "deferred", "blocked", "escalated", "denied"]
          },
          "publication_status": {
            "enum": ["none", "pushed-branch", "hosted-main-updated"]
          },
          "durable_history": {
            "properties": {
              "kind": {
                "enum": ["commit", "patch", "checkpoint", "branch"]
              }
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["pr_url"] },
            { "required": ["pr_number"] },
            {
              "properties": {
                "durable_history": {
                  "required": ["pr_url"]
                }
              }
            },
            {
              "properties": {
                "durable_history": {
                  "properties": {
                    "kind": { "const": "pr" }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_route": { "const": "branch-no-pr" },
          "lifecycle_outcome": { "const": "branch-local-complete" }
        }
      },
      "then": {
        "properties": {
          "integration_status": {
            "enum": ["not_landed", "not_applicable"]
          },
          "publication_status": {
            "enum": ["none", "pushed-branch"]
          },
          "durable_history": {
            "properties": {
              "kind": { "const": "commit" }
            }
          },
          "closeout_outcome": {
            "enum": ["continued", "blocked", "escalated", "denied"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_route": { "const": "branch-no-pr" },
          "lifecycle_outcome": { "const": "published-branch" }
        }
      },
      "then": {
        "required": ["remote_branch_ref"],
        "properties": {
          "integration_status": {
            "enum": ["not_landed", "not_applicable"]
          },
          "publication_status": {
            "const": "pushed-branch"
          },
          "closeout_outcome": {
            "enum": ["continued", "blocked", "escalated", "denied"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_route": { "const": "branch-no-pr" },
          "lifecycle_outcome": {
            "enum": ["landed", "cleaned"]
          }
        }
      },
      "then": {
        "required": [
          "landing_authorization_ref",
          "hosted_landing",
          "landing_evaluation",
          "landed_ref",
          "target_branch_ref",
          "integration_method",
          "main_alignment"
        ],
        "properties": {
          "integration_status": {
            "const": "landed"
          },
          "publication_status": {
            "const": "hosted-main-updated"
          },
          "integration_method": {
            "const": "fast-forward"
          },
          "durable_history": {
            "properties": {
              "kind": {
                "enum": ["commit", "branch"]
              }
            }
          },
          "hosted_landing": {
            "properties": {
              "fast_forward_only": { "const": true }
            }
          },
          "landing_evaluation": {
            "properties": {
              "status": {
                "enum": ["attempted", "succeeded"]
              }
            }
          },
          "main_alignment": {
            "properties": {
              "aligned": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_route": { "const": "branch-pr" },
          "lifecycle_outcome": { "const": "preserved" }
        }
      },
      "then": {
        "properties": {
          "integration_status": {
            "enum": ["not_landed", "not_applicable"]
          },
          "publication_status": {
            "const": "none"
          },
          "durable_history": {
            "properties": {
              "kind": {
                "enum": ["commit", "patch", "checkpoint", "branch"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_route": { "const": "branch-pr" },
          "lifecycle_outcome": { "const": "published" }
        }
      },
      "then": {
        "properties": {
          "integration_status": {
            "enum": ["not_landed", "not_applicable"]
          },
          "publication_status": {
            "const": "pr-opened"
          },
          "durable_history": {
            "properties": {
              "kind": { "const": "pr" },
              "pr_url": { "type": "string", "minLength": 1 }
            },
            "required": ["kind", "ref", "pr_url"]
          },
          "closeout_outcome": {
            "enum": ["continued", "blocked", "escalated", "denied"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_route": { "const": "branch-pr" },
          "lifecycle_outcome": { "const": "ready" }
        }
      },
      "then": {
        "properties": {
          "integration_status": {
            "enum": ["not_landed", "not_applicable"]
          },
          "publication_status": {
            "const": "pr-ready"
          },
          "durable_history": {
            "properties": {
              "kind": { "const": "pr" },
              "pr_url": { "type": "string", "minLength": 1 }
            },
            "required": ["kind", "ref", "pr_url"]
          },
          "closeout_outcome": {
            "enum": ["continued", "blocked", "escalated", "denied"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_route": { "const": "branch-pr" },
          "lifecycle_outcome": {
            "enum": ["landed", "cleaned"]
          }
        }
      },
      "then": {
        "required": ["landed_ref", "target_branch_ref", "integration_method"],
        "properties": {
          "integration_status": {
            "const": "landed"
          },
          "publication_status": {
            "const": "pr-merged"
          },
          "durable_history": {
            "properties": {
              "kind": { "const": "pr" },
              "pr_url": { "type": "string", "minLength": 1 }
            },
            "required": ["kind", "ref", "pr_url"]
          },
          "main_alignment": {
            "properties": {
              "aligned": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "selected_route": { "const": "direct-main" } } },
      "then": {
        "required": ["landed_ref", "target_branch_ref", "main_alignment"],
        "properties": {
          "target_lifecycle_outcome": {
            "enum": ["landed", "cleaned"]
          },
          "lifecycle_outcome": {
            "enum": ["landed", "cleaned"]
          },
          "integration_status": {
            "const": "landed"
          },
          "publication_status": {
            "enum": ["none", "hosted-main-updated", "not_applicable"]
          },
          "integration_method": {
            "const": "direct-commit"
          },
          "durable_history": {
            "properties": {
              "kind": { "const": "commit" }
            }
          },
          "main_alignment": {
            "properties": {
              "aligned": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "integration_status": { "const": "landed" }
        }
      },
      "then": {
        "required": ["landed_ref", "target_branch_ref", "integration_method", "main_alignment"],
        "properties": {
          "lifecycle_outcome": {
            "enum": ["landed", "cleaned"]
          },
          "durable_history": {
            "properties": {
              "kind": {
                "enum": ["commit", "branch", "pr"]
              }
            }
          },
          "main_alignment": {
            "properties": {
              "aligned": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_outcome": {
            "enum": ["landed", "cleaned"]
          }
        }
      },
      "then": {
        "required": ["landed_ref", "target_branch_ref", "integration_method", "main_alignment"],
        "properties": {
          "integration_status": {
            "const": "landed"
          },
          "durable_history": {
            "properties": {
              "kind": {
                "enum": ["commit", "branch", "pr"]
              }
            }
          },
          "main_alignment": {
            "properties": {
              "aligned": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_lifecycle_outcome": {
            "enum": ["landed", "cleaned"]
          },
          "integration_status": {
            "enum": ["not_landed", "not_applicable"]
          }
        },
        "required": ["target_lifecycle_outcome", "integration_status"]
      },
      "then": {
        "required": ["landing_evaluation", "not_landed_reason", "landing_stop_reason"],
        "properties": {
          "closeout_outcome": {
            "enum": ["continued", "stage_only", "blocked", "escalated", "denied"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_lifecycle_outcome": { "const": "cleaned" },
          "lifecycle_outcome": {
            "enum": ["preserved", "branch-local-complete", "published-branch", "published", "ready", "landed", "deferred", "blocked", "escalated", "denied"]
          }
        },
        "required": ["target_lifecycle_outcome", "lifecycle_outcome"]
      },
      "then": {
        "required": ["not_cleaned_reason", "cleanup_stop_reason"],
        "properties": {
          "closeout_outcome": {
            "enum": ["continued", "stage_only", "blocked", "escalated", "denied"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_outcome": { "const": "cleaned" }
        }
      },
      "then": {
        "properties": {
          "cleanup_status": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cleanup_status": { "const": "completed" }
        }
      },
      "then": {
        "required": ["cleanup_evidence_refs"],
        "properties": {
          "cleanup_evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cleanup_status": { "const": "deferred" }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": ["cleanup_evidence_refs"],
            "properties": {
              "cleanup_evidence_refs": { "minItems": 1 }
            }
          },
          {
            "required": ["external_blocker_refs"],
            "properties": {
              "external_blocker_refs": { "minItems": 1 }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "selected_route": {
            "enum": ["branch-no-pr", "branch-pr"]
          },
          "source_branch_cleanup": {
            "properties": {
              "status": { "const": "completed" }
            },
            "required": ["status"]
          },
          "cleanup_status": { "const": "completed" }
        },
        "required": ["selected_route", "source_branch_cleanup", "cleanup_status"]
      },
      "then": {
        "required": ["cleanup_authorization_ref"]
      }
    },
    {
      "if": {
        "properties": {
          "selected_route": {
            "enum": ["branch-no-pr", "branch-pr"]
          },
          "integration_status": { "const": "landed" },
          "closeout_outcome": { "const": "completed" }
        }
      },
      "then": {
        "required": ["source_branch_integration", "source_branch_cleanup", "main_alignment"],
        "properties": {
          "cleanup_status": {
            "enum": ["completed", "deferred"]
          },
          "main_alignment": {
            "required": [
              "origin_fetch_evidence_ref",
              "local_main_sync_evidence_ref",
              "origin_main_contains_landed_ref",
              "local_main_contains_landed_ref"
            ],
            "properties": {
              "origin_main_contains_landed_ref": { "const": true },
              "local_main_contains_landed_ref": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "lifecycle_outcome": { "const": "preserved" } } },
      "then": {
        "properties": {
          "integration_status": {
            "enum": ["not_landed", "not_applicable"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_outcome": { "const": "deferred" }
        },
        "required": ["lifecycle_outcome"]
      },
      "then": {
        "required": ["remaining_blockers"],
        "properties": {
          "integration_status": {
            "enum": ["not_landed", "not_applicable"]
          },
          "cleanup_status": {
            "enum": ["pending", "deferred", "not_applicable"]
          },
          "closeout_outcome": {
            "enum": ["continued", "stage_only", "blocked", "escalated", "denied"]
          },
          "remaining_blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": { "properties": { "selected_route": { "const": "stage-only-escalate" } } },
      "then": {
        "properties": {
          "lifecycle_outcome": {
            "enum": ["preserved", "deferred", "blocked", "escalated", "denied"]
          },
          "target_lifecycle_outcome": {
            "enum": ["preserved", "blocked", "escalated", "denied"]
          },
          "integration_status": {
            "enum": ["not_landed", "not_applicable"]
          },
          "publication_status": {
            "enum": ["none", "not_applicable"]
          },
          "closeout_outcome": {
            "enum": ["stage_only", "blocked", "escalated", "denied"]
          }
        }
      }
    }
  ]
}
