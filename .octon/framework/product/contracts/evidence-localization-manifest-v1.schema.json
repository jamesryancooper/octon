{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://octon.local/contracts/evidence-localization-manifest-v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","repository","archive_id","localization_run_id","created_at","tool_version","source_refs","inventory_digest","entries","rollback_instructions","state"],
  "properties":{
    "schema_version":{"const":"evidence-localization-manifest-v1"},
    "repository":{"type":"object","required":["identity","canonical_origin","root_fingerprint"],"additionalProperties":false,"properties":{"identity":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"canonical_origin":{"type":"string","minLength":1},"root_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}},
    "archive_id":{"type":"string","pattern":"^archive-[0-9a-f]{32}$"},
    "localization_run_id":{"type":"string","pattern":"^localize-[0-9a-f]{32}$"},
    "created_at":{"type":"string","minLength":1},"tool_version":{"type":"string","minLength":1},
    "source_refs":{"type":"object","required":["main","origin_main"],"properties":{"main":{"type":"string"},"origin_main":{"type":"string"}}},
    "inventory_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "entries":{"type":"array","minItems":1,"items":{"type":"object","required":["source_path","destination_path","file_type","size","digest","owning_run_id","lifecycle_id","evidence_class","retention_reason","reference_relationships","active_state_verdict","active_state_evidence","manual_review_disposition","copy_result","verification_result","cleanup_eligibility"],"properties":{"source_path":{"type":"string"},"destination_path":{"type":"string"},"file_type":{"enum":["file"]},"size":{"type":"integer","minimum":0},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"owning_run_id":{"type":"string"},"lifecycle_id":{"type":"string"},"evidence_class":{"type":"string"},"retention_reason":{"type":"string"},"reference_relationships":{"type":"array","items":{"type":"string"}},"active_state_verdict":{"type":"string"},"active_state_evidence":{"type":"array","items":{"type":"string"}},"manual_review_disposition":{"type":"string"},"copy_result":{"enum":["copied","reused"]},"verification_result":{"const":"verified"},"cleanup_eligibility":{"const":true}}}},
    "rollback_instructions":{"type":"string","minLength":1},"state":{"const":"verified"}
  }
}
