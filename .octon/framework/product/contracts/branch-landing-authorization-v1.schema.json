{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/framework/product/contracts/branch-landing-authorization-v1.schema.json",
  "title": "Octon Branch Landing Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "authorization_result",
    "selected_route",
    "target_lifecycle_outcome",
    "remote",
    "target_branch",
    "source_branch",
    "source_ref",
    "remote_source_ref",
    "target_pre_ref",
    "provider_ruleset_ref",
    "no_pr_required",
    "preflight_status",
    "required_check_refs",
    "allow_empty_check_set",
    "rollback_handle",
    "host_controls_not_bypassed",
    "runtime_safety_boundary",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "branch-landing-authorization-v1"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_result": {
      "type": "string",
      "enum": ["approved", "denied"]
    },
    "selected_route": {
      "const": "branch-no-pr"
    },
    "target_lifecycle_outcome": {
      "type": "string",
      "enum": ["landed", "cleaned"]
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "target_branch": {
      "type": "string",
      "minLength": 1
    },
    "source_branch": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "remote_source_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_pre_ref": {
      "type": "string",
      "minLength": 1
    },
    "provider_ruleset_ref": {
      "type": "string",
      "minLength": 1
    },
    "no_pr_required": {
      "const": true
    },
    "preflight_status": {
      "const": "passed"
    },
    "required_check_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allow_empty_check_set": {
      "type": "boolean"
    },
    "empty_check_set_rationale": {
      "type": "string",
      "minLength": 1
    },
    "rollback_handle": {
      "type": "string",
      "minLength": 1
    },
    "host_controls_not_bypassed": {
      "const": true
    },
    "runtime_safety_boundary": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allow_empty_check_set": {
            "const": true
          }
        },
        "required": ["allow_empty_check_set"]
      },
      "then": {
        "required": ["empty_check_set_rationale"]
      }
    }
  ]
}
