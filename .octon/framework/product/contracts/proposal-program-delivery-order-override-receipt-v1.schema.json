{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/contracts/proposal-program-delivery-order-override-receipt-v1.schema.json",
  "title": "Proposal Program Delivery Order Override Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "emitted_at",
    "target_program",
    "run_binding",
    "requested_order",
    "operator_authority",
    "efficiency_risk_acknowledgement",
    "revocation",
    "non_authority_classification",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "proposal-program-delivery-order-override-receipt-v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "emitted_at": {
      "type": "string",
      "minLength": 1
    },
    "target_program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "accepted_review_digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "accepted_review_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_run_id",
        "profile_id"
      ],
      "properties": {
        "delivery_run_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requested_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_order_ref",
        "requested_order_ref",
        "operator_requested_alternative_order",
        "rationale"
      ],
      "properties": {
        "canonical_order_ref": {
          "const": "child-before-parent-delivery"
        },
        "requested_order_ref": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "child-before-parent-delivery"
          }
        },
        "operator_requested_alternative_order": {
          "const": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operator_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "authority_source"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "authority_source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "efficiency_risk_acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledged",
        "acknowledged_by",
        "acknowledged_at",
        "risk_summary"
      ],
      "properties": {
        "acknowledged": {
          "const": true
        },
        "acknowledged_by": {
          "type": "string",
          "minLength": 1
        },
        "acknowledged_at": {
          "type": "string",
          "minLength": 1
        },
        "risk_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revoked",
        "stale_after",
        "supersedes_receipt_ref"
      ],
      "properties": {
        "revoked": {
          "type": "boolean"
        },
        "stale_after": {
          "type": "string",
          "minLength": 1
        },
        "supersedes_receipt_ref": {
          "type": "string"
        }
      }
    },
    "non_authority_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_local_files",
        "generated_prompts",
        "generated_outputs",
        "dashboards",
        "chat_or_model_memory"
      ],
      "properties": {
        "proposal_local_files": {
          "const": "non-authority"
        },
        "generated_prompts": {
          "const": "non-authority"
        },
        "generated_outputs": {
          "const": "derived-only-non-authority"
        },
        "dashboards": {
          "const": "non-authority"
        },
        "chat_or_model_memory": {
          "const": "non-authority"
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_evidence_only",
        "authorizes_delivery",
        "authorizes_child_receipt_replacement",
        "authorizes_archive",
        "authorizes_git_mutation",
        "authorizes_cleanup"
      ],
      "properties": {
        "retained_evidence_only": {
          "const": true
        },
        "authorizes_delivery": {
          "const": false
        },
        "authorizes_child_receipt_replacement": {
          "const": false
        },
        "authorizes_archive": {
          "const": false
        },
        "authorizes_git_mutation": {
          "const": false
        },
        "authorizes_cleanup": {
          "const": false
        }
      }
    }
  }
}
