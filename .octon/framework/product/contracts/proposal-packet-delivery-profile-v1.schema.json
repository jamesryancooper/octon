{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon.local/contracts/proposal-packet-delivery-profile-v1.schema.json",
  "title": "Proposal Packet Delivery Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "created_at",
    "target_packet_path",
    "target_outcome",
    "containment_policy",
    "route_preference",
    "pr_policy",
    "stash_policy",
    "packet_execution",
    "packet_state_routing",
    "required_proposal_validators",
    "required_implementation_validators",
    "publication_checks",
    "mechanism_integration_checks",
    "promotion_requirements",
    "closeout_requirements",
    "hygiene_requirements",
    "terminal_proof_requirements",
    "final_sync_requirements",
    "non_authority_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "proposal-packet-delivery-profile-v1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "target_packet_path": {
      "type": "string",
      "minLength": 1
    },
    "target_outcome": {
      "enum": [
        "implemented",
        "archive-ready"
      ]
    },
    "containment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "publication_effects_enabled", "exact_work_preserved"],
      "properties": {
        "reason_code": {"const": "RP00_CONTAINMENT_PUBLICATION_DISABLED"},
        "publication_effects_enabled": {"const": false},
        "exact_work_preserved": {"const": true}
      }
    },
    "route_preference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_unit_route",
        "landing_route",
        "pr_creation_allowed"
      ],
      "properties": {
        "work_unit_route": {
          "const": "stage-only"
        },
        "landing_route": {
          "const": "not-applicable"
        },
        "pr_creation_allowed": {
          "type": "boolean"
        }
      }
    },
    "pr_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allow_pr_creation",
        "fallback_to_pr"
      ],
      "properties": {
        "mode": {
          "enum": [
            "forbid-pr",
            "allow-pr",
            "require-pr"
          ]
        },
        "allow_pr_creation": {
          "type": "boolean"
        },
        "fallback_to_pr": {
          "type": "boolean"
        }
      }
    },
    "stash_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "preserve_unrelated_work"
      ],
      "properties": {
        "mode": {
          "enum": [
            "forbidden",
            "allowed"
          ]
        },
        "preserve_unrelated_work": {
          "type": "boolean"
        }
      }
    },
    "packet_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replan_after_material_changes",
        "target_owned_receipts_required",
        "aggregate_receipt_replaces_target_receipts",
        "self_authorization_allowed"
      ],
      "properties": {
        "replan_after_material_changes": {
          "type": "boolean"
        },
        "target_owned_receipts_required": {
          "type": "boolean"
        },
        "aggregate_receipt_replaces_target_receipts": {
          "type": "boolean"
        },
        "self_authorization_allowed": {
          "type": "boolean"
        }
      }
    },
    "packet_state_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_archive_states",
        "already_archived_states",
        "pre_archive_required_owners",
        "already_archived_required_owners",
        "missing_state_evidence_outcome",
        "blocked_receipt_requires_explicit_blockers",
        "blocked_receipt_requires_next_owning_lifecycle"
      ],
      "properties": {
        "pre_archive_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "implemented",
              "closeout-ready",
              "archive-ready"
            ]
          }
        },
        "already_archived_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "archived",
              "change-closeout-pending",
              "landed",
              "synced"
            ]
          }
        },
        "pre_archive_required_owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "closeout-packet",
              "proposal-packet-terminal-closeout",
              "archive-proposal"
            ]
          }
        },
        "already_archived_required_owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "archive-proposal",
              "closeout-change",
              "closeout-worktree",
              "repo-hygiene-cleanup"
            ]
          }
        },
        "missing_state_evidence_outcome": {
          "const": "blocked"
        },
        "blocked_receipt_requires_explicit_blockers": {
          "const": true
        },
        "blocked_receipt_requires_next_owning_lifecycle": {
          "const": true
        }
      }
    },
    "required_proposal_validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_implementation_validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publication_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owning_publishers_only",
        "generated_outputs_are_non_authority",
        "freshness_validator",
        "direct_generated_output_edits_allowed"
      ],
      "properties": {
        "owning_publishers_only": {
          "type": "boolean"
        },
        "generated_outputs_are_non_authority": {
          "type": "boolean"
        },
        "freshness_validator": {
          "type": "string",
          "minLength": 1
        },
        "direct_generated_output_edits_allowed": {
          "type": "boolean"
        }
      }
    },
    "mechanism_integration_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_when_applicable",
        "receipt_required_when_required"
      ],
      "properties": {
        "required_when_applicable": {
          "type": "boolean"
        },
        "receipt_required_when_required": {
          "type": "boolean"
        }
      }
    },
    "promotion_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promote_proposal_required",
        "implemented_status_required",
        "promotion_receipt_required"
      ],
      "properties": {
        "promote_proposal_required": {
          "type": "boolean"
        },
        "implemented_status_required": {
          "type": "boolean"
        },
        "promotion_receipt_required": {
          "type": "boolean"
        }
      }
    },
    "closeout_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_closeout_required",
        "terminal_closeout_required",
        "archive_lifecycle_required",
        "change_closeout_required",
        "delegate_git_mutation_to_change_closeout"
      ],
      "properties": {
        "packet_closeout_required": {
          "type": "boolean"
        },
        "terminal_closeout_required": {
          "type": "boolean"
        },
        "archive_lifecycle_required": {
          "type": "boolean"
        },
        "change_closeout_required": {
          "const": false
        },
        "delegate_git_mutation_to_change_closeout": {
          "const": false
        }
      }
    },
    "hygiene_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanup_authorization_required",
        "classification_alone_authorizes_deletion"
      ],
      "properties": {
        "cleanup_authorization_required": {
          "const": false
        },
        "classification_alone_authorizes_deletion": {
          "type": "boolean"
        }
      }
    },
    "terminal_proof_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_current_state_proof_required",
        "worktree_hygiene_required"
      ],
      "properties": {
        "terminal_current_state_proof_required": {
          "const": false
        },
        "worktree_hygiene_required": {
          "const": false
        }
      }
    },
    "final_sync_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_origin_landed_ref_equality_required"
      ],
      "properties": {
        "main_origin_landed_ref_equality_required": {
          "const": false
        }
      }
    },
    "non_authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_local_files",
        "generated_prompts",
        "generated_outputs",
        "dashboards",
        "chat_or_model_memory"
      ],
      "properties": {
        "proposal_local_files": {
          "const": "non-authority"
        },
        "generated_prompts": {
          "const": "non-authority"
        },
        "generated_outputs": {
          "const": "derived-only-non-authority"
        },
        "dashboards": {
          "const": "non-authority"
        },
        "chat_or_model_memory": {
          "const": "non-authority"
        }
      }
    }
  }
}
